{
  "manifest_version": 3,
  "name": "Playmobil Warenkorb-Helfer",
  "description": "Automatisches Befüllen und Exportieren des Playmobil-Warenkorbs",
  "version": "1.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.playmobil.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.playmobil.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
